# Database. Local MongoDB by default; for MongoDB Atlas paste the
# mongodb+srv://... connection string instead.
FAIRTRIAGE_MONGO_URL=mongodb://localhost:27017
FAIRTRIAGE_MONGO_DB=fairtriage

# Copy to .env. Never commit .env, and never paste a key into a chat,
# an email or a screenshot. If a key is ever exposed, revoke it and create
# a new one.
#
# FAIRTRIAGE_EXTRACTOR picks who reads the messages:
#   keyword    hand-written rules, fully offline (the default)
#   gemini     needs GEMINI_API_KEY     free key at https://aistudio.google.com/apikey
#   anthropic  needs ANTHROPIC_API_KEY  https://console.anthropic.com (prepaid credits)
#   openai     needs OPENAI_API_KEY     https://platform.openai.com (prepaid credits)
FAIRTRIAGE_EXTRACTOR=keyword

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides
# FAIRTRIAGE_GEMINI_MODEL=gemini-3.1-flash-lite
# FAIRTRIAGE_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# FAIRTRIAGE_OPENAI_MODEL=gpt-4.1-mini
